{
  "format": "aicad-drafting-recipe",
  "version": 1,
  "validation": "strict",
  "description": "局所座標mm・ラジアン。寸法式と作図順序の正本。曲線はmethod.curvePolicyに従う数値近似。",
  "method": {
    "id": "doreme-new",
    "version": "0.1.0",
    "name": "新ドレメ式・前後袖ぐりダーツ",
    "unit": "mm",
    "requiredMeasurements": [
      "bust",
      "backLength",
      "armLength",
      "neckCircumference",
      "acrossShoulder",
      "backWidth",
      "chestWidth",
      "bustPointSpacing"
    ],
    "supportedDesignParameters": [
      "sleeveLength"
    ],
    "inputRanges": {
      "bust": [
        800,
        900
      ],
      "backLength": [
        350,
        420
      ],
      "armLength": [
        450,
        650
      ],
      "sleeveLength": [
        350,
        800
      ],
      "neckCircumference": [
        320,
        420
      ],
      "acrossShoulder": [
        340,
        440
      ],
      "backWidth": [
        300,
        400
      ],
      "chestWidth": [
        280,
        380
      ],
      "bustPointSpacing": [
        140,
        220
      ]
    },
    "curvePolicy": "doreme-provisional-close-redraw-v3",
    "sources": [
      "https://maisondeas.com/pattern-block-new-doreme/"
    ]
  },
  "templates": {
    "close-redraw-open": {
      "parameters": [
        "shoulder",
        "widthPoint",
        "underarm",
        "apex",
        "upperMark",
        "lowerMark",
        "slope"
      ],
      "steps": [
        {
          "id": "normal",
          "value": {
            "$op": "vector",
            "args": [
              {
                "$op": "multiply",
                "args": [
                  -1,
                  {
                    "$op": "sin",
                    "args": [
                      {
                        "$ref": "slope"
                      }
                    ]
                  }
                ]
              },
              {
                "$op": "cos",
                "args": [
                  {
                    "$ref": "slope"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "initial",
          "value": {
            "$call": "armhole-arcs",
            "args": {
              "shoulder": {
                "$ref": "shoulder"
              },
              "guide": {
                "$ref": "widthPoint"
              },
              "underarm": {
                "$ref": "underarm"
              },
              "shoulderTangent": {
                "$ref": "normal"
              }
            }
          }
        },
        {
          "id": "provisional",
          "value": {
            "$op": "path",
            "args": [
              [
                {
                  "$ref": "initial.upper"
                },
                {
                  "$ref": "initial.lower"
                }
              ]
            ]
          }
        },
        {
          "id": "a",
          "value": {
            "$op": "get",
            "args": [
              {
                "$op": "rayHit",
                "args": [
                  {
                    "$ref": "provisional"
                  },
                  {
                    "$ref": "apex"
                  },
                  {
                    "$ref": "upperMark"
                  }
                ]
              },
              "point"
            ]
          }
        },
        {
          "id": "b",
          "value": {
            "$op": "get",
            "args": [
              {
                "$op": "rayHit",
                "args": [
                  {
                    "$ref": "provisional"
                  },
                  {
                    "$ref": "apex"
                  },
                  {
                    "$ref": "lowerMark"
                  }
                ]
              },
              "point"
            ]
          }
        },
        {
          "id": "u",
          "value": {
            "$op": "vectorTo",
            "args": [
              {
                "$ref": "apex"
              },
              {
                "$ref": "upperMark"
              }
            ]
          }
        },
        {
          "id": "w",
          "value": {
            "$op": "vectorTo",
            "args": [
              {
                "$ref": "apex"
              },
              {
                "$ref": "lowerMark"
              }
            ]
          }
        },
        {
          "id": "angle",
          "value": {
            "$op": "atan2",
            "args": [
              {
                "$op": "subtract",
                "args": [
                  {
                    "$op": "multiply",
                    "args": [
                      {
                        "$ref": "u.x"
                      },
                      {
                        "$ref": "w.y"
                      }
                    ]
                  },
                  {
                    "$op": "multiply",
                    "args": [
                      {
                        "$ref": "u.y"
                      },
                      {
                        "$ref": "w.x"
                      }
                    ]
                  }
                ]
              },
              {
                "$op": "add",
                "args": [
                  {
                    "$op": "multiply",
                    "args": [
                      {
                        "$ref": "u.x"
                      },
                      {
                        "$ref": "w.x"
                      }
                    ]
                  },
                  {
                    "$op": "multiply",
                    "args": [
                      {
                        "$ref": "u.y"
                      },
                      {
                        "$ref": "w.y"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "intake",
          "require": {
            "$op": "and",
            "args": [
              {
                "$op": "gt",
                "args": [
                  {
                    "$ref": "angle"
                  },
                  0
                ]
              },
              {
                "$op": "lt",
                "args": [
                  {
                    "$ref": "angle"
                  },
                  1.5707963267948966
                ]
              }
            ]
          },
          "message": "袖ぐりダーツの分量が成立しません"
        },
        {
          "id": "close",
          "value": {
            "$op": "rotation",
            "args": [
              {
                "$ref": "angle"
              },
              {
                "$ref": "apex"
              }
            ]
          }
        },
        {
          "id": "open",
          "value": {
            "$op": "inverse",
            "args": [
              {
                "$ref": "close"
              }
            ]
          }
        },
        {
          "id": "closedShoulder",
          "value": {
            "$op": "apply",
            "args": [
              {
                "$ref": "close"
              },
              {
                "$ref": "shoulder"
              }
            ]
          }
        },
        {
          "id": "fairingPoint",
          "value": {
            "$op": "lerp",
            "args": [
              {
                "$op": "apply",
                "args": [
                  {
                    "$ref": "close"
                  },
                  {
                    "$ref": "a"
                  }
                ]
              },
              {
                "$ref": "b"
              },
              0.5
            ]
          }
        },
        {
          "id": "arcs",
          "value": {
            "$call": "armhole-arcs",
            "args": {
              "shoulder": {
                "$ref": "closedShoulder"
              },
              "guide": {
                "$ref": "fairingPoint"
              },
              "underarm": {
                "$ref": "underarm"
              },
              "shoulderTangent": {
                "$op": "apply",
                "args": [
                  {
                    "$ref": "close"
                  },
                  {
                    "$ref": "normal"
                  }
                ]
              }
            }
          }
        },
        {
          "id": "closed",
          "value": {
            "$op": "path",
            "args": [
              [
                {
                  "$ref": "arcs.upper"
                },
                {
                  "$ref": "arcs.lower"
                }
              ]
            ]
          }
        },
        {
          "id": "parts",
          "value": {
            "$op": "splitHit",
            "args": [
              {
                "$ref": "closed"
              },
              {
                "$op": "rayHit",
                "args": [
                  {
                    "$ref": "closed"
                  },
                  {
                    "$ref": "apex"
                  },
                  {
                    "$ref": "lowerMark"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "opened",
          "value": {
            "$op": "apply",
            "args": [
              {
                "$ref": "open"
              },
              {
                "$ref": "parts.0"
              }
            ]
          }
        }
      ],
      "result": {
        "provisional": {
          "$ref": "provisional"
        },
        "upper": {
          "$op": "pinStart",
          "args": [
            {
              "$ref": "opened"
            },
            {
              "$ref": "shoulder"
            }
          ]
        },
        "lower": {
          "$ref": "parts.1"
        },
        "closed": {
          "$ref": "closed"
        },
        "closedShoulder": {
          "$ref": "closedShoulder"
        },
        "angle": {
          "$ref": "angle"
        }
      }
    },
    "doreme-bodice": {
      "parameters": [
        "id",
        "neckCenter",
        "neckSide",
        "shoulder",
        "underarm",
        "waistY",
        "widthPoint",
        "apex",
        "marks",
        "slope"
      ],
      "steps": [
        {
          "id": "ah",
          "value": {
            "$call": "close-redraw-open",
            "args": {
              "shoulder": {
                "$ref": "shoulder"
              },
              "widthPoint": {
                "$ref": "widthPoint"
              },
              "underarm": {
                "$ref": "underarm"
              },
              "apex": {
                "$ref": "apex"
              },
              "slope": {
                "$ref": "slope"
              },
              "upperMark": {
                "$ref": "marks.0"
              },
              "lowerMark": {
                "$ref": "marks.1"
              }
            }
          }
        },
        {
          "id": "dartId",
          "value": {
            "$if": {
              "$op": "equal",
              "args": [
                {
                  "$ref": "id"
                },
                "front"
              ]
            },
            "then": "bust-dart",
            "else": "shoulder-dart"
          }
        },
        {
          "id": "legA",
          "value": {
            "$op": "textJoin",
            "args": [
              {
                "$ref": "dartId"
              },
              "-in"
            ]
          }
        },
        {
          "id": "legB",
          "value": {
            "$op": "textJoin",
            "args": [
              {
                "$ref": "dartId"
              },
              "-out"
            ]
          }
        },
        {
          "id": "relation",
          "value": {
            "$op": "textJoin",
            "args": [
              {
                "$ref": "id"
              },
              "-",
              {
                "$ref": "dartId"
              }
            ]
          }
        },
        {
          "id": "waist",
          "value": {
            "$op": "point",
            "args": [
              {
                "$ref": "underarm.x"
              },
              {
                "$ref": "waistY"
              }
            ]
          }
        },
        {
          "id": "centerWaist",
          "value": {
            "$op": "point",
            "args": [
              0,
              {
                "$ref": "waistY"
              }
            ]
          }
        },
        {
          "id": "shoulderLine",
          "value": {
            "$op": "line",
            "args": [
              {
                "$ref": "neckSide"
              },
              {
                "$ref": "shoulder"
              }
            ]
          }
        },
        {
          "id": "edges",
          "value": [
            {
              "id": "neckline",
              "role": "open",
              "path": {
                "$op": "smooth",
                "args": [
                  [
                    {
                      "$ref": "neckCenter"
                    },
                    {
                      "$ref": "neckSide"
                    }
                  ],
                  [
                    {
                      "$op": "vector",
                      "args": [
                        1,
                        0
                      ]
                    },
                    {
                      "$op": "vector",
                      "args": [
                        0,
                        -1
                      ]
                    }
                  ]
                ]
              }
            },
            {
              "id": "shoulder",
              "role": "sew",
              "path": {
                "$ref": "shoulderLine"
              }
            },
            {
              "id": "armhole-upper",
              "role": "sew",
              "path": {
                "$ref": "ah.upper"
              }
            },
            {
              "id": {
                "$ref": "legA"
              },
              "role": "sew",
              "path": {
                "$op": "line",
                "args": [
                  {
                    "$ref": "ah.upper.end"
                  },
                  {
                    "$ref": "apex"
                  }
                ]
              }
            },
            {
              "id": {
                "$ref": "legB"
              },
              "role": "sew",
              "path": {
                "$op": "line",
                "args": [
                  {
                    "$ref": "apex"
                  },
                  {
                    "$ref": "ah.lower.start"
                  }
                ]
              }
            },
            {
              "id": "armhole",
              "role": "sew",
              "path": {
                "$ref": "ah.lower"
              }
            },
            {
              "id": "side",
              "role": "sew",
              "path": {
                "$op": "line",
                "args": [
                  {
                    "$ref": "underarm"
                  },
                  {
                    "$ref": "waist"
                  }
                ]
              }
            },
            {
              "id": "waist",
              "role": "open",
              "path": {
                "$op": "line",
                "args": [
                  {
                    "$ref": "waist"
                  },
                  {
                    "$ref": "centerWaist"
                  }
                ]
              }
            },
            {
              "id": "center",
              "role": "fold",
              "path": {
                "$op": "line",
                "args": [
                  {
                    "$ref": "centerWaist"
                  },
                  {
                    "$ref": "neckCenter"
                  }
                ]
              }
            }
          ]
        },
        {
          "id": "landmarks",
          "value": {
            "$op": "merge",
            "args": [
              {
                "neckCenter": {
                  "$ref": "neckCenter"
                },
                "neckSide": {
                  "$ref": "neckSide"
                },
                "shoulder": {
                  "$ref": "shoulder"
                },
                "underarm": {
                  "$ref": "underarm"
                },
                "centerWaist": {
                  "$ref": "centerWaist"
                }
              },
              {
                "sideWaist": {
                  "$ref": "waist"
                },
                "armholeWidthPoint": {
                  "$ref": "widthPoint"
                },
                "dartUpperMark": {
                  "$ref": "marks.0"
                },
                "dartLowerMark": {
                  "$ref": "marks.1"
                }
              },
              {
                "$if": {
                  "$op": "equal",
                  "args": [
                    {
                      "$ref": "id"
                    },
                    "front"
                  ]
                },
                "then": {
                  "bustPoint": {
                    "$ref": "apex"
                  }
                },
                "else": {
                  "dartPoint": {
                    "$ref": "apex"
                  }
                }
              }
            ]
          }
        },
        {
          "id": "piece",
          "value": {
            "$op": "piece",
            "args": [
              {
                "id": {
                  "$ref": "id"
                },
                "name": {
                  "$if": {
                    "$op": "equal",
                    "args": [
                      {
                        "$ref": "id"
                      },
                      "front"
                    ]
                  },
                  "then": "前身頃",
                  "else": "後身頃"
                },
                "edges": {
                  "$ref": "edges"
                },
                "cut": {
                  "quantity": 1,
                  "onFold": true,
                  "mirroredPair": false,
                  "seamAllowance": 0
                },
                "grainline": {
                  "$op": "fitGrain",
                  "args": [
                    {
                      "$op": "boundary",
                      "args": [
                        {
                          "$ref": "edges"
                        }
                      ]
                    },
                    {
                      "$op": "line",
                      "args": [
                        {
                          "$op": "point",
                          "args": [
                            35,
                            {
                              "$op": "add",
                              "args": [
                                {
                                  "$ref": "underarm.y"
                                },
                                15
                              ]
                            }
                          ]
                        },
                        {
                          "$op": "point",
                          "args": [
                            35,
                            {
                              "$op": "subtract",
                              "args": [
                                {
                                  "$ref": "waistY"
                                },
                                20
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                "darts": [
                  {
                    "id": {
                      "$ref": "dartId"
                    },
                    "apex": {
                      "$ref": "apex"
                    },
                    "legA": {
                      "$ref": "legA"
                    },
                    "legB": {
                      "$ref": "legB"
                    },
                    "relation": {
                      "$ref": "relation"
                    },
                    "intakeAngleRad": {
                      "$ref": "ah.angle"
                    }
                  }
                ],
                "landmarks": {
                  "$ref": "landmarks"
                },
                "guides": [
                  {
                    "name": "袖ぐり基礎線（引き直し前）",
                    "path": {
                      "$ref": "ah.provisional"
                    }
                  },
                  {
                    "name": "ダーツ作図線・上",
                    "path": {
                      "$op": "line",
                      "args": [
                        {
                          "$ref": "apex"
                        },
                        {
                          "$ref": "marks.0"
                        }
                      ]
                    }
                  },
                  {
                    "name": "ダーツ作図線・下",
                    "path": {
                      "$op": "line",
                      "args": [
                        {
                          "$ref": "apex"
                        },
                        {
                          "$ref": "marks.1"
                        }
                      ]
                    }
                  },
                  {
                    "name": "ダーツ分量作図線",
                    "path": {
                      "$op": "line",
                      "args": [
                        {
                          "$ref": "marks.0"
                        },
                        {
                          "$ref": "marks.1"
                        }
                      ]
                    }
                  },
                  {
                    "name": "肩への展開線",
                    "path": {
                      "$op": "line",
                      "args": [
                        {
                          "$op": "lerp",
                          "args": [
                            {
                              "$ref": "shoulderLine.start"
                            },
                            {
                              "$ref": "shoulderLine.end"
                            },
                            0.5
                          ]
                        },
                        {
                          "$ref": "apex"
                        }
                      ]
                    }
                  },
                  {
                    "name": {
                      "$if": {
                        "$op": "equal",
                        "args": [
                          {
                            "$ref": "id"
                          },
                          "front"
                        ]
                      },
                      "then": "胸幅線",
                      "else": "背幅線"
                    },
                    "path": {
                      "$op": "line",
                      "args": [
                        {
                          "$op": "point",
                          "args": [
                            0,
                            {
                              "$ref": "widthPoint.y"
                            }
                          ]
                        },
                        {
                          "$ref": "widthPoint"
                        }
                      ]
                    }
                  },
                  {
                    "name": "バスト線",
                    "path": {
                      "$op": "line",
                      "args": [
                        {
                          "$op": "point",
                          "args": [
                            0,
                            {
                              "$op": "add",
                              "args": [
                                {
                                  "$ref": "underarm.y"
                                },
                                10
                              ]
                            }
                          ]
                        },
                        {
                          "$op": "point",
                          "args": [
                            {
                              "$ref": "underarm.x"
                            },
                            {
                              "$op": "add",
                              "args": [
                                {
                                  "$ref": "underarm.y"
                                },
                                10
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  }
                ],
                "notches": []
              }
            ]
          }
        }
      ],
      "result": {
        "piece": {
          "$ref": "piece"
        },
        "closedArmhole": {
          "$ref": "ah.closed"
        },
        "closedShoulder": {
          "$ref": "ah.closedShoulder"
        }
      }
    },
    "doreme-bodices": {
      "parameters": [],
      "steps": [
        {
          "id": "depth",
          "value": {
            "$op": "add",
            "args": [
              {
                "$op": "divide",
                "args": [
                  {
                    "$ref": "body.backLength"
                  },
                  2
                ]
              },
              20
            ]
          }
        },
        {
          "id": "side",
          "value": {
            "$op": "divide",
            "args": [
              {
                "$op": "add",
                "args": [
                  {
                    "$ref": "body.bust"
                  },
                  80
                ]
              },
              4
            ]
          }
        },
        {
          "id": "backWidth",
          "value": {
            "$op": "divide",
            "args": [
              {
                "$ref": "body.backWidth"
              },
              2
            ]
          }
        },
        {
          "id": "chestWidth",
          "value": {
            "$op": "divide",
            "args": [
              {
                "$ref": "body.chestWidth"
              },
              2
            ]
          }
        },
        {
          "id": "backNeckWidth",
          "value": {
            "$op": "add",
            "args": [
              {
                "$op": "divide",
                "args": [
                  {
                    "$ref": "body.neckCircumference"
                  },
                  6
                ]
              },
              10
            ]
          }
        },
        {
          "id": "frontNeckWidth",
          "value": {
            "$op": "subtract",
            "args": [
              {
                "$ref": "backNeckWidth"
              },
              5
            ]
          }
        },
        {
          "id": "rise",
          "value": {
            "$op": "divide",
            "args": [
              {
                "$ref": "backNeckWidth"
              },
              3
            ]
          }
        },
        {
          "id": "backNeck",
          "value": {
            "$op": "point",
            "args": [
              {
                "$ref": "backNeckWidth"
              },
              {
                "$op": "multiply",
                "args": [
                  -1,
                  {
                    "$ref": "rise"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "frontNeck",
          "value": {
            "$op": "point",
            "args": [
              {
                "$ref": "frontNeckWidth"
              },
              {
